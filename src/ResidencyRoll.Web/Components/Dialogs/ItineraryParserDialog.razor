@using Radzen
@using Radzen.Blazor
@using ResidencyRoll.Shared.Trips

<style>
    .itinerary-spinner {
        width: 20px;
        height: 20px;
        border: 3px solid #b6d4fe;
        border-top-color: #0d6efd;
        border-radius: 50%;
        animation: itinerary-spin 0.8s linear infinite;
    }

    @@keyframes itinerary-spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div style="display: flex; flex-direction: column; gap: 1rem;">
    <RadzenText TextStyle="TextStyle.Caption" style="color: #666; display: block;">
        Paste flight information from emails, booking confirmations, or any text format. We'll auto-fill your trip legs.
    </RadzenText>

    <RadzenTextArea @bind-Value="itineraryText"
                   Placeholder="Paste your flight itinerary here... (e.g., AC099 YHZ to YUL Jan 23 2026 4:40 PM, AC100 YUL to YHZ Jan 30 2026 2:15 PM)"
                   Disabled="@isParsing"
                   Style="width: 100%; min-height: 120px;" />

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
        <RadzenButton Icon="flight"
                     Text="Parse Itinerary"
                     Click="@ParseItinerary"
                     ButtonStyle="ButtonStyle.Info"
                     Size="ButtonSize.Small"
                     Disabled="@isParsing" />
        <RadzenButton Icon="clear"
                     Text="Clear"
                     Click="@ClearText"
                     ButtonStyle="ButtonStyle.Light"
                     Size="ButtonSize.Small"
                     Disabled="@isParsing" />
        <RadzenButton Icon="close"
                     Text="Close"
                     Click="@CloseDialog"
                     ButtonStyle="ButtonStyle.Secondary"
                     Size="ButtonSize.Small"
                     Disabled="@isParsing" />
    </RadzenStack>

    @if (isParsing)
    {
        <div style="padding: 0.75rem; background-color: #e7f1ff; border-radius: 4px; display: flex; align-items: center; gap: 0.75rem;">
            <div class="itinerary-spinner"></div>
            <RadzenText TextStyle="TextStyle.Body2"><em>Analyzing your itinerary with AI...</em></RadzenText>
        </div>
    }

    @if (!string.IsNullOrEmpty(itineraryParsingError))
    {
        <RadzenAlert Severity="AlertSeverity.Error">
            <strong>Parsing Error:</strong> @itineraryParsingError
        </RadzenAlert>
    }
</div>
