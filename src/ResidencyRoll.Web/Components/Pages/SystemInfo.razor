@page "/system-info"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Radzen
@using Radzen.Blazor
@rendermode InteractiveServer

<PageTitle>System Info - Residency Roll</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">System Info</RadzenText>

@if (loading)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else if (errorMessage != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@errorMessage</RadzenAlert>
}
else if (info != null)
{
    <RadzenCard class="rz-mt-3">
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">Database</RadzenText>
        <table class="system-info-table">
            <tbody>
                <tr><th>Location</th><td><code>@info.DatabasePath</code></td></tr>
                <tr><th>Status</th><td>@(info.DatabaseExists ? "File found" : "File not found")</td></tr>
                <tr><th>Size</th><td>@FormatSize(info.DatabaseSizeBytes)</td></tr>
                <tr><th>Users</th><td>@info.UserCount</td></tr>
                <tr><th>Trips</th><td>@info.TripCount</td></tr>
            </tbody>
        </table>
    </RadzenCard>

    <RadzenCard class="rz-mt-3">
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">Backups</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" class="system-backups-summary">
            @(info.NextBackupUtc is { } next
                ? $"Next scheduled backup: {next:yyyy-MM-dd HH:mm} UTC (weekly, Mondays)"
                : "Scheduled backups are disabled.")
        </RadzenText>
        <RadzenButton Text="Backup now" Click="BackupNowAsync" Disabled="backingUp" IsBusy="backingUp" />
        @if (backupMessage != null)
        {
            <RadzenAlert class="rz-mt-3" AlertStyle="@(backupFailed ? AlertStyle.Danger : AlertStyle.Success)" Variant="Variant.Flat" AllowClose="false">@backupMessage</RadzenAlert>
        }
        @if (info.Backups.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-4">No backups yet.</RadzenText>
        }
        else
        {
            <table class="system-backups-table">
                <thead>
                    <tr><th>File</th><th>Created (UTC)</th><th>Size</th><th><span class="rz-sr-only">Download</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var backup in info.Backups)
                    {
                        <tr>
                            <td><code>@backup.FileName</code></td>
                            <td>@backup.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@FormatSize(backup.SizeBytes)</td>
                            <td>
                                <a class="rz-button rz-button-sm rz-variant-filled rz-light rz-shadow-0" href="/app/system/backups/@Uri.EscapeDataString(backup.FileName)" download="@backup.FileName" data-enhance-nav="false" target="_top">
                                    <span class="rz-button-box"><span class="rz-button-text">Download</span></span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </RadzenCard>

    <RadzenCard class="rz-mt-3">
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">Application</RadzenText>
        <table class="system-info-table">
            <tbody>
                <tr><th>API version</th><td>@info.ApplicationVersion</td></tr>
                <tr><th>Environment</th><td>@info.Environment</td></tr>
            </tbody>
        </table>
    </RadzenCard>
}
